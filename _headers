# Cabeceras para el hosting (las leen Cloudflare, Netlify y varios más).
#
# La importante es la del service worker: si el navegador guarda sw.js en su
# caché, una versión nueva de la aplicación no llega nunca al teléfono, aunque
# se haya subido bien. Es el fallo más difícil de diagnosticar de todos, porque
# todo parece correcto salvo que los cambios no aparecen.

/sw.js
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

# Algunos hostings no reconocen la extensión .webmanifest y lo entregan como
# texto plano; con el tipo equivocado, Android no ofrece instalar la aplicación.
/manifest.webmanifest
  Content-Type: application/manifest+json

# Los .js y el .css llevan siempre el mismo nombre, así que no se pueden dejar
# guardados: el navegador se quedaría con el código viejo, y se lo serviría al
# service worker cuando éste fuera a buscar la versión nueva. Los cambios no
# aparecerían y no habría ningún error que lo explicara.
/js/*
  Cache-Control: no-cache, must-revalidate

/css/*
  Cache-Control: no-cache, must-revalidate
